# Vorlage fuer Produktion und lokalen Betrieb. Echte Werte NIE committen.

# --- Postgres (docker-compose.yml baut DATABASE_URL daraus) ---
POSTGRES_USER=tetra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tetra
# Nur fuer Betrieb ohne Compose (z. B. pnpm dev gegen lokale DB):
DATABASE_URL=postgres://tetra:change-me@localhost:5432/tetra

# --- Auth (Better Auth) ---
# Lang und zufaellig: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Oeffentliche URL ohne Slash am Ende, in Produktion https://<domain>
BETTER_AUTH_URL=http://localhost:3000
# Zusaetzliche erlaubte Origins, kommagetrennt (optional)
TRUSTED_ORIGINS=
# Registrierung: Standard false = nur der allererste Nutzer darf sich registrieren.
# true erzwingt offene Registrierung (nur kurzzeitig/Notfall setzen).
ALLOW_SIGNUP=false

# --- IP-Sperre (Panel nur von VPN-IP erreichbar) ---
# Kommagetrennt, IPv4/IPv6, optional CIDR. Leer = Sperre aus (in Produktion Start-Warnung).
# Oeffentlich bleiben nur /legal/**, /api/health und statische Assets (/_nuxt).
ALLOWED_IPS=178.105.17.179
# Anzahl vertrauenswuerdiger Proxys vor der App (Coolify/Traefik = 1). Es wird der Eintrag
# von RECHTS in X-Forwarded-For genommen. 0 = Header ignorieren, Socket-IP nutzen.
TRUSTED_PROXY_HOPS=1

# --- Verschluesselung ---
# 32 Byte: 64 Hex-Zeichen oder Base64 (openssl rand -hex 32). Verlust = Secrets unwiederbringlich.
ENCRYPTION_KEY=
# Nur waehrend Key-Rotation: alter Schluessel
ENCRYPTION_KEY_PREVIOUS=

# --- Laufzeit ---
# Drizzle-Migrationsordner (im Container /app/drizzle; lokal automatisch gefunden)
# MIGRATIONS_DIR=/app/drizzle
# Temporaerer Medienpuffer (im Container Volume /data/media; wird ab den Medien-Paketen genutzt)
# MEDIA_BUFFER_DIR=/data/media
